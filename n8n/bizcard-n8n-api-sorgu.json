        "parameters": {
          "jsCode": "// n8n API'den gelen execution'lari bu haftaya (Pazartesi 00:00'dan itibaren) filtreleyip olay turune gore sayar.\nconst weekStart = $now.startOf(\"week\");\nconst sonuc = { haftaBaslangici: weekStart.toFormat(\"yyyy-MM-dd\"), buHaftaToplamIstek: 0, kartKaydi: 0, toplantiTalebi: 0, basarisiz: 0, tumZamanlarToplantiTalebi: 0 };\nfor (const item of $input.all()) {\n  const j = item.json;\n  const raw = JSON.stringify(j.data || {});\n  const toplanti = raw.includes(\"meeting.request\");\n  const kart = raw.includes(\"card.save\");\n  if (toplanti) sonuc.tumZamanlarToplantiTalebi++;\n  if (DateTime.fromISO(j.startedAt) < weekStart) continue;\n  sonuc.buHaftaToplamIstek++;\n  if (toplanti) sonuc.toplantiTalebi++;\n  else if (kart) sonuc.kartKaydi++;\n  if (j.status === \"error\") sonuc.basarisiz++;\n}\nreturn [{ json: sonuc }];"
        }
      }
