        "parameters": {
          "jsCode": "// Form tek bir item uretir; uc PDF'i ayri item'lara boler ve her birine kendi metadata'sini ekler.\nconst item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (keys.length < 3) {\n  throw new Error(\"Uc PDF dosyasi yuklenmelidir: profil rehberi, toplanti politikasi ve kurumsal rehber.\");\n}\nconst dokumanlar = [\n  {\n    dokuman_turu: \"profil_hizmetler\",\n    dokuman_versiyonu: item.json[\"Profil Rehberi Versiyonu\"],\n    meta_title: \"Profil, Hizmetler ve Kullanım Rehberi\",\n    meta_description: \"Sercan BALLI'nın uzmanlık alanları, hizmetleri, çalışma şekli ve dijital kartvizit kullanımı.\",\n    meta_keywords: \"profil, uzmanlık, hizmetler, çalışma şekli, kartvizit kullanımı, kartı kaydet, telefonuma ekle, QR kod\",\n  },\n  {\n    dokuman_turu: \"toplanti_iletisim\",\n    dokuman_versiyonu: item.json[\"Toplanti Politikasi Versiyonu\"],\n    meta_title: \"Toplantı ve İletişim Politikası\",\n    meta_description: \"Toplantı talebi süreci, yanıt süresi, müsait saatler, toplantı süresi, iptal ve KVKK bilgileri.\",\n    meta_keywords: \"toplantı, randevu, yanıt süresi, müsait saat, süre, iptal, KVKK\",\n  },\n  {\n    dokuman_turu: \"kurumsal_bilgi\",\n    dokuman_versiyonu: item.json[\"Kurumsal Rehber Versiyonu\"],\n    meta_title: \"Veri Endüstri Mühendislik A.Ş. Kurumsal Tanıtım ve Bilgi Rehberi\",\n    meta_description: \"Şirket hakkında, faaliyet alanları, sektörler, çözüm paketleri, çalışma yöntemi, teknoloji, gizlilik, kariyer, iletişim ve sık sorulan sorular.\",\n    meta_keywords: \"Veri Endüstri, şirket, kurumsal, faaliyet alanları, sektörler, çözüm paketleri, teknoloji, kariyer, staj, iletişim, SSS\",\n  },\n];\nreturn dokumanlar.map((d, i) => ({\n  json: { ...d, kaynak_dokuman: item.binary[keys[i]].fileName, eklenme_tarihi: item.json.submittedAt },\n  binary: { data: item.binary[keys[i]] },\n}));"
        }
      },
