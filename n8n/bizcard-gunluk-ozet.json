      {
        "id": "779697d1-a41f-40b7-8019-92bd6c1fe2ca",
        "name": "Kaydi Hazirla",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1480,
          140
        ],
        "parameters": {
          "jsCode": "// Dongu govdesi: her kaydi ozet icin tek bicime getirir.\nreturn $input.all().map((i) => ({ json: { tur: i.json.tur, adSoyad: i.json[\"Ad Soyad\"] || \"(adsiz)\" } }));"
        }
      },
      {
        "id": "f036d843-e42d-460c-ab78-87bd5f4bf88d",
        "name": "Turlere Gore Grupla",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1480,
          -140
        ],
        "parameters": {
          "jsCode": "// Dongu bittiginde tum kayitlar burada toplanir; olay turune gore gruplanir.\nconst today = $now.toFormat(\"yyyy-MM-dd\");\nconst groups = {};\nfor (const item of $input.all()) {\n  const { tur, adSoyad } = item.json;\n  if (!groups[tur]) groups[tur] = { sayi: 0, kisiler: [] };\n  groups[tur].sayi += 1;\n  groups[tur].kisiler.push(adSoyad);\n}\nreturn Object.keys(groups).map((tur) => ({ json: { ozetTarihi: today, tur, kayitSayisi: groups[tur].sayi, kisiler: groups[tur].kisiler.join(\", \") } }));"
        }
      },
